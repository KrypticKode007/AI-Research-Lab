│   └── scrcpy/                  # Offline Android display & input bridge
├── services/                    # Domain microservices & compute engines
│   ├── PatchPilot/              # FastAPI audio mastering service
│   ├── nkryptd/                 # (-nkryptd) Cyber-resilience & BI engine
│   └── root/                    # C++ scientific big-data processing
├── edge/                        # Robotics, neuromorphic & power hardware
│   ├── golden-rosa-template/    # NASA-JPL ROSA / ROS2 MCP bridge
│   ├── bio-edge-organism/       # C++11 / Python SNN & ESP32 active inference
│   ├── Autonomous-Battery/      # (Autonomous-Battery-)
│   └── self-healing-battery/    # (Autonomous-self-healing-battery)
├── devops/                      # Self-healing CI/CD & automated patching
